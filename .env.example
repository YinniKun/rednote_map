# Discord Bot Settings
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=
ALLOWED_CHANNEL_IDS=

# LLM Configuration (OpenAI, Gemini, Anthropic, or OpenAI-Compatible)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Pinning Strategy ('sheets', 'kml', 'playwright', or 'none')
# Recommended: 'sheets' (Syncs directly with Google My Maps layer)
PINNER_STRATEGY=sheets
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Local KML Output File (if strategy is 'kml')
KML_OUTPUT_FILE=saved_places.kml
